# Copy this file to .env and fill in real values for local development.
# See README.md "Setup" and "Data sources" sections for details on each key.

# --- Database ---
# Hosted Postgres (Prisma Postgres via the Vercel Storage integration), used
# for both local dev and production. An earlier version of this project used
# local SQLite, but Vercel's serverless filesystem can't reliably serve a
# bundled SQLite file at runtime (reads 500'd, writes wouldn't have persisted
# anyway) — see README for the history. Get a connection string by connecting
# a database under the Vercel project's Storage tab (or point this at any
# other Postgres instance — Neon, Supabase, RDS, etc. all work).
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# --- EIA API v2 (https://www.eia.gov/opendata) ---
# Free key, required for src/lib/ingest/eia.ts. Sign up at eia.gov/opendata/register.php
EIA_API_KEY=""

# --- Federal Permitting Dashboard (https://permits.performance.gov/tools/api-docs) ---
# As of research for this project, the Permitting Dashboard API did not appear to
# require a key for read access to public FAST-41 project data, but this is left
# here in case that changes or a higher-rate-limit key becomes available.
PERMITTING_DASHBOARD_API_KEY=""

# --- Map ---
# MapLibre GL is used with an open (non-Mapbox-token) style by default. If you
# swap in a Mapbox-hosted style or Mapbox GL JS directly, add your token here.
MAPBOX_TOKEN=""

# --- Contact form (src/app/api/contact) ---
# Free API key from resend.com — no domain verification needed to send from
# the shared onboarding@resend.dev address used here. Free tier is generous
# (3,000 emails/month) and plenty for a contact form.
RESEND_API_KEY=""

# --- Scheduled ingestion (src/app/api/cron/ingest-eia) ---
# Required in production so the cron endpoint can't be triggered by a random
# request — Vercel automatically sends this as a Bearer token on scheduled
# invocations once it's set in the project's env vars (see vercel.json
# "crons"). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""
