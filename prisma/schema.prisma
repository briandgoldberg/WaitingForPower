// Waiting — Energy Project Tracker
//
// Uses a hosted Postgres instance (Prisma Postgres, connected via the
// Vercel Storage integration) for both local dev and production — v1
// originally shipped with local SQLite, but Vercel's serverless filesystem
// can't reliably serve a bundled SQLite file at runtime (see git history /
// README), so this project standardized on one shared Postgres instead of
// running two different datasource providers in dev vs. prod.
//
// Cause categories and their paired reform levers are NOT modeled as a DB
// table on purpose — they are a fixed, small, code-reviewed set that lives
// in src/lib/data/causeCategories.ts as the single source of truth. Projects
// and submissions reference a cause by its slug (string), validated in app
// code against that module rather than a DB foreign key.

generator client {
  provider = "prisma-client-js"
}

// url is the Accelerate (pooled) connection Prisma Client actually queries
// through at runtime; directUrl is the raw direct connection (the one
// Vercel's Prisma Postgres integration provisions as DATABASE_URL, and the
// only one `prisma migrate deploy` can use) — see src/lib/db.ts for the
// client-side half of this, and its comment for why: an uncapped direct
// connection multiplied across serverless instances took the whole site
// down (2026-09-14) once the un-pooled connection limit was reached.
datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_ACCELERATE_URL")
  directUrl = env("DATABASE_URL")
}

model Project {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Stable cross-source identity key from the ingestion pipeline (see
  // src/lib/ingest/common.ts and manualOverrides.ts) — `${source}:${sourceId}`
  // by default, or a shared value a human has explicitly declared via
  // manualOverrides.csv when two different sources track the same physical
  // project. This is the real identity used to decide whether an ingestion
  // run is updating an existing project or creating a new one; `slug` is
  // derived from it once at creation and then never changes, so bookmarked
  // URLs stay stable even as a project's own display name changes across
  // updates. Null for the handful of legacy rows written before this column
  // existed (isAggregateExample seed rows, pre-dating this project's
  // updatable-sources-only rebuild).
  matchKey String? @unique

  // generation | transmission | storage | lng | pipeline
  projectType String

  // solar | wind_onshore | wind_offshore | storage | gas | nuclear | hydro
  // | lng | pipeline | transmission | geothermal | other
  fuelType String

  lat    Float?
  lon    Float?
  state  String?
  county String?

  // "MW" for most generation/storage/transmission; LNG uses "MTPA"; some
  // pipeline entries store a length/diameter descriptor instead of a single
  // throughput number when public reporting didn't give one (see dataQualityNote).
  capacityValue Float?
  capacityUnit  String?

  applicationFiledDate DateTime?
  // "exact" | "approximate" — many public dates are year-level or
  // milestone-level precision rather than a specific day; be honest about it.
  dateConfidence       String    @default("exact")

  // The project's own developer/applicant/owner, where its source publishes
  // one as a distinct field (most state docket sources do — the applicant
  // name is usually already parsed out to help build the project's display
  // `name`, e.g. "Hecate Energy Columbia County 1, LLC"). Null wherever a
  // source doesn't clearly separate it, rather than guessing from the
  // display name's own free text.
  applicant String?

  // When this project is expected to actually come online — EIA-860M
  // publishes a planned operation month/year for generation, and LBNL
  // Queued Up publishes an estimated commercial-operation date for
  // interconnection-queue entries. Null for every other source (most state
  // docket sources publish no forward-looking date at all). Deliberately
  // separate from applicationFiledDate/dateConfidence above — this is a
  // different date with its own, often coarser, precision.
  expectedOnlineDate           DateTime?
  expectedOnlineDateConfidence String? // "exact" | "approximate", same convention as dateConfidence above

  currentStatus String

  // interconnection_study | environmental_review | planned_pre_filing |
  // regulatory_approvals_pending (EIA "Category L") | agency_permitting |
  // local_review | litigation | approved_awaiting_construction |
  // under_construction | cancelled | completed
  currentStage String

  // The REAL calendar date this project reached a resolved stage (see
  // RESOLVED_STAGES in taxonomies.ts) — as opposed to ProjectChange.createdAt,
  // which only records when our own cron run happened to notice it. Only set
  // by the handful of ingest modules that actually extract a real dated
  // order/decision document from their source; every other module leaves
  // this field alone entirely (undefined, not null) rather than overwriting
  // it — see keepExistingIfUnmanaged in common.ts. Null for every project
  // from a source that's never been wired for this, or that hasn't resolved
  // yet. See src/lib/ingest/README.md for current per-state coverage.
  resolutionDate           DateTime?
  resolutionDateConfidence String? // "exact" | "approximate", same convention as dateConfidence above

  causeDetail String

  // Finer-grained than currentStage for interconnection-queue sources only
  // (e.g. LBNL Queued Up's own "Feasibility Study" / "System Impact Study" /
  // "Facilities Study" labels) — currentStage stays the shared seven-stage
  // taxonomy every source populates, this is a source-specific detail layered
  // on top. Null for every other source.
  interconnectionQueueStage String?

  // LBNL Queued Up's own "queue cluster (if applicable)" field — confirmed
  // live 2026-09-04 against the real 2026-edition codebook: populated for
  // ~50% of currently-tracked active >=250MW rows, values are a mix of study
  // years ("2024", "2025") and named cohorts ("Cluster 1", "Transition Late
  // Stage") depending on the interconnecting utility's own convention, not a
  // single standardized ID scheme. Stored as-is (stringified), not
  // normalized across utilities. Null for every other source.
  queueCluster String?

  // LBNL Queued Up's own "poi_name" field — the substation name or
  // transmission line tap this project is interconnecting at (confirmed live
  // 2026-09-04: populated for ~93% of rows). The real-world basis for
  // "competing projects sharing the same point of interconnection," a
  // concern real due-diligence checklists flag explicitly. Null for every
  // other source.
  pointOfInterconnection String?

  // The grid balancing authority / ISO-RTO territory (e.g. "PJM", "MISO",
  // "NEVP") — populated from EIA-860M's "Balancing Authority Code" and LBNL
  // Queued Up's own "region"/"entity" fields, both already fetched by those
  // modules for other purposes (LBNL only ever surfaced this baked into
  // currentStatus's free text before now). A developer screens by ISO/RTO
  // territory before almost anything else, so this deserves its own
  // queryable field rather than being buried in a string. Null for every
  // source that doesn't publish one.
  balancingAuthority String?

  // EIA-860M's own "Sector" column (e.g. "Electric Utility", "IPP Non-CHP",
  // "Commercial") — the owning entity's ownership/business type, distinct
  // from `applicant` (the entity's name). EIA-only; null elsewhere.
  ownerSector String?

  // EIA-860M's "Net Summer/Winter Capacity (MW)" — the deliverable capacity
  // after seasonal derating, distinct from `capacityValue` (nameplate).
  // EIA-only; null elsewhere.
  netSummerCapacityMw Float?
  netWinterCapacityMw Float?

  // EIA-860M's "Prime Mover Code" (e.g. "PV", "WT", "BA", "CT", "CA") — finer
  // equipment-type detail than the shared `fuelType` taxonomy (distinguishes,
  // e.g., a simple-cycle gas turbine from a combined-cycle plant). See
  // PRIME_MOVER_LABELS in src/lib/data/taxonomies.ts for display labels.
  // EIA-only; null elsewhere.
  primeMoverCode String?

  // Preliminary network-upgrade cost estimate in USD, joined in from LBNL's
  // separate interconnection cost-analysis datasets by matchKey — see
  // src/lib/ingest/lbnlInterconnectionCostsPjm.ts (PJM only so far; MISO,
  // SPP, ISO-NE, NYISO, and the non-ISO BAs are each their own separate
  // publication, not yet joined — see that module's header). Always paired
  // with a dataQualityNote — LBNL's own docs call these estimates
  // preliminary, and the underlying studies are irregularly-updated
  // per-region snapshots, not a live figure. Owned entirely by that join
  // module, not by lbnlQueuedUp.ts's own regular re-ingestion — see
  // keepExistingIfNull in common.ts for why a routine queue re-ingestion
  // run must never null this back out.
  networkUpgradeCostUsd Float?

  // The point-of-interconnection cost component, split out from
  // networkUpgradeCostUsd (the broader transmission-network-reinforcement
  // component) — real developers care about this split specifically
  // (network upgrades are the dominant, harder-to-predict share of total
  // interconnection cost). Same source/module/caveats as
  // networkUpgradeCostUsd above.
  poiCostUsd Float?

  // True for entries that represent a regional/aggregate statistic
  // (e.g. "PJM Interconnection Queue") rather than one physical project.
  // Always shown with a clear label — never mixed silently into per-project
  // counts that imply "N individual projects."
  isAggregateExample Boolean @default(false)

  estimatedMwDelayed Float?

  // verified | user_submitted_pending | user_submitted_verified
  verificationStatus String @default("verified")

  // Free-text caveat surfaced in the UI, e.g. "Capacity figure is the
  // developer-stated design capacity; not independently verified."
  dataQualityNote String?

  // True when this project's own source last confirmed it was STILL
  // tracked as still-pending (currentStage not in RESOLVED_STAGES), but
  // then a later run of that same source's candidate list didn't include
  // it anymore — set by upsertNormalizedProjects (common.ts), never
  // guessed at the per-module level. Deliberately does NOT change
  // currentStage (which keeps holding the true last-known real stage) —
  // this is an orthogonal "are we still seeing it" signal, surfaced as its
  // own Status filter bucket ("No Longer Being Reported", see
  // statusBucketForProject in taxonomies.ts) rather than folded into
  // Cancelled/Suspended, since we genuinely don't know what happened
  // (could be resolved off-book, could just be a source search quirk).
  // Only ever set true for a still-pending project — an already-resolved
  // project dropping out of a source's "active" search is expected
  // behavior, not a signal. Cleared automatically the next time that same
  // matchKey is seen again in a run.
  noLongerReported Boolean   @default(false)
  // Set when this row is the same physical project as another (see
  // src/lib/dedupe.ts): points at the row that represents it. Merged rows are
  // kept (ingest keeps updating them) but hidden from lists, totals and search;
  // their sources and best fields show on the canonical row.
  mergedIntoId     String?
  // Where a state docket stands procedurally, e.g. "Awaiting commission order"
  // (hearing held or case sent straight to the commission, no final order yet),
  // "Hearing scheduled", "Application filed". Set by the docket ingests that can
  // read filing history; null elsewhere. reviewStepAt is the date of the filing
  // that put it in that step.
  reviewStep       String?
  reviewStepAt     DateTime?
  // Last day to send a public comment on this project, when the source
  // publishes one (for example Oregon's timeline "Comment Deadline" rows).
  // Null means unknown, not "no comment period".
  commentDeadline  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Where to learn more about this project's hearings — one link per
  // project (not per hearing, see ProjectHearing below): almost every
  // source's own "how to participate" destination is the case/docket's own
  // detail page, the same URL regardless of which specific hearing you're
  // asking about, so one shared link is both simpler and more accurate
  // than pretending each hearing has its own distinct notice page. Null
  // for every source that hasn't been wired for this yet — see
  // src/lib/ingest/common.ts's keepExistingIfUnmanaged for why a source
  // that's never touched this field can't accidentally wipe another
  // source's value.
  hearingDetailsLink String?

  causes      ProjectCause[]
  sources     ProjectSource[]
  milestones  Milestone[]
  hearings    ProjectHearing[]
  changes     ProjectChange[]
  predictions Prediction[]
  comments    ProjectComment[]

  @@index([projectType])
  @@index([fuelType])
  @@index([currentStage])
  @@index([verificationStatus])
  @@index([noLongerReported])
  @@index([mergedIntoId])
}

// A subscription to the homepage changes feed, optionally scoped to one
// state — replaces the original per-project ProjectSubscription (removed
// 2026-09; real usage over its whole life was zero confirmed subscribers,
// because a single project changes far too rarely — site-wide volume is
// only ~3-5 ProjectChange rows/day across thousands of tracked projects,
// so a per-project subscriber was being promised roughly one email a year).
// Not tied to a Project row at all — `state` is a plain USPS code rather
// than a relation, since the scope is a filter over ProjectChange, not a
// single project. Double opt-in for the same reason the old model had it: a
// mistyped or someone-else's address can't get subscribed without clicking
// the confirm link.
//
// `state` is NOT NULL with "" meaning "every state" — deliberately not
// nullable, even though the concept is "an optional filter": Prisma's
// generated findUnique/upsert input for a compound @@unique containing a
// nullable field won't accept null (confirmed live — a real TS2322 type
// error, not a guess), because a Postgres unique index doesn't treat
// multiple NULLs as duplicates, so "unique" lookup-by-null isn't reliable.
// The rest of the app still represents "no state selected" as `null` — see
// each Prisma call site (src/app/api/feed-subscribe/*,
// src/app/api/cron/notify-feed-subscribers) for the `?? ""` / `|| null`
// mapping right at this boundary.
//
// Sent weekly regardless of whether anything changed in scope (see
// src/app/api/cron/notify-feed-subscribers/route.ts) — unlike the old
// per-project model, which skipped a subscriber entirely on a quiet week.
// A predictable "yes, still watching" cadence is the point here; the email
// itself says plainly when there's nothing new.
model FeedSubscription {
  id    String @id @default(cuid())
  email String
  // USPS code, e.g. "CA" — "" means every state (the unfiltered feed).
  state String @default("")

  confirmed        Boolean @default(false)
  // Random 32-byte hex tokens (see src/lib/subscriptionTokens.ts) — opaque
  // bearer capabilities, not guessable from the row's other fields.
  confirmToken     String  @unique
  unsubscribeToken String  @unique

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  // Cursor into ProjectChange.createdAt. Set to confirmedAt at confirm
  // time (not createdAt/epoch) so a new subscriber's first email covers
  // changes going forward only, not the feed's entire backdated history.
  lastNotifiedAt DateTime?

  @@unique([email, state])
  @@index([state])
  @@index([confirmed])
}

// One row per ingestion source, written once its real backfill is done —
// see `suppressNewChangeLog` / `isBackfillRun` in common.ts. A source's
// very first ingestion run makes every candidate look "new" to the diff,
// even though they're just pre-existing dockets the site is only now
// starting to track; left unsuppressed that floods the changes feed on day
// one. The obvious signal for "is this day one" — this source currently
// has zero Project rows — isn't reliable enough on its own: a developer
// manually running `npm run ingest:<source>` against the same database
// used for both local dev and production (see schema header) before that
// source's cron ever fires for real seeds a handful of rows, which makes
// the *real* first cron run look like it isn't day one anymore, and it
// floods the feed with everything the manual run hadn't already caught
// (confirmed live 2026-08-27: exactly this happened to Maine DEP, Louisiana
// PSC, and Rhode Island EFSB). This table is the fix: a source is only
// ever considered backfilled once a run actually invoked by the live
// Vercel cron (not a manual CLI run — see `isLiveCronRun` in common.ts)
// completes while this row doesn't yet exist for it. A manual CLI run
// never writes this row and never posts real feed events itself, so it
// can't burn the one true backfill exemption a source gets.
model IngestSourceBackfill {
  // `${source}:` prefix of Project.matchKey for this source, e.g. "me-dep" —
  // see sourcePrefixOf in common.ts.
  sourcePrefix String   @id
  completedAt  DateTime @default(now())
}

// One row per (project, ingestion run) where something worth telling a
// user about actually changed — the data source for the homepage "changes"
// feed (the site's core value prop as of 2026-08-25: actionable
// intelligence on what changed, not just a static snapshot). Deliberately
// bundles every change type detected in one run into a single row (one
// event per project per run), not one row per changed field — see
// upsertNormalizedProject in common.ts for the detection logic. A run that
// changes nothing about a project writes no row at all; this table is not
// a full audit log of every ingestion run, only the runs that produced a
// real, user-facing change.
model ProjectChange {
  id        Int     @id @default(autoincrement())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // One or more of: "new" | "advanced" | "resolved" | "fact_revised" |
  // "new_filing" | "no_longer_reported" | "reappeared" — see
  // buildChangeSummary in common.ts for what triggers each and how they're
  // combined into `summary` below. Kept as a Postgres string array (not a
  // separate join table) since this is a small, fixed, code-reviewed
  // vocabulary read far more often than written, the same reasoning
  // causeCategories.ts already documents for cause slugs.
  changeTypes String[]

  // Only set when a "advanced" or "resolved" changeType fired — the real
  // stage transition, for a more structured feed UI than parsing `summary`.
  previousStage String?
  newStage      String?

  // Pre-rendered human-readable summary (e.g. "Advanced from
  // Interconnection Study to Agency Permitting; capacity revised to 187
  // MW"), computed once at ingest time rather than recomputed per page
  // view — the underlying old/new field values that produced it aren't all
  // separately persisted (e.g. previous capacity), so this is the
  // authoritative record of what was observed to change.
  summary String

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model ProjectCause {
  id        Int    @id @default(autoincrement())
  projectId String
  // slug matching src/lib/data/causeCategories.ts — see note above
  causeSlug String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, causeSlug])
  @@index([causeSlug])
}

model ProjectSource {
  id        Int    @id @default(autoincrement())
  projectId String
  label     String
  url       String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Lets upsertNormalizedProject (common.ts) update-or-insert its own
  // source link by (projectId, label) instead of wiping every source on the
  // project each run — the mechanism that lets two different ingestion
  // sources sharing one matchKey both keep their own source link on the
  // same merged Project row, rather than the second run's write silently
  // deleting the first's.
  @@unique([projectId, label])
}

model Milestone {
  id             Int      @id @default(autoincrement())
  projectId      String
  date           DateTime
  dateConfidence String   @default("exact")
  stage          String
  description    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// One row per real, upcoming hearing this project's own source publishes —
// deliberately not capped at one, since real docket data regularly shows a
// project with two or more (e.g. a "Local public hearing" AND a separate
// "Evidentiary hearing", or several genuinely distinct hearing dates on one
// Louisiana docket). Only ever populated by the small set of ingest
// modules that parse structured hearing data — see
// Project.hearingDetailsLink and src/lib/ingest/common.ts's
// upsertNormalizedProject, which deletes and recreates every row for a
// project on each run of a participating source (so a hearing that's
// passed or been cancelled disappears on the next run, never left stale) —
// but only for a source that actually passes a `hearings` array at all;
// every other source's projects are left untouched.
model ProjectHearing {
  id        Int       @id @default(autoincrement())
  projectId String
  date      DateTime
  endDate   DateTime?
  // Free text from the source, e.g. "Local public hearing", "Evidentiary
  // hearing", "Formal Hearing" — null when the source doesn't name a type.
  label     String?
  // Venue/address (or "Telephonically" / "Via Microsoft Teams" etc.) exactly
  // as the source publishes it — null when the source doesn't name one.
  location  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([date])
}

// User-submitted projects. Never shown publicly until an admin approves them
// (status flips to "approved" and a real Project row is created) — see
// src/app/admin and src/app/api/admin/submissions.
model Submission {
  id   String @id @default(cuid())
  name String

  projectType String
  fuelType    String

  lat    Float?
  lon    Float?
  state  String?
  county String?

  capacityValue Float?
  capacityUnit  String?

  applicationFiledDate DateTime?

  // Comma-separated cause slugs chosen by the submitter — kept as a plain
  // string here (not normalized into ProjectCause rows) until approved.
  causeSlugs  String
  causeDetail String

  // Required per spec: at least one supporting source link. Stored as
  // newline-separated raw text; split/validated in app code.
  sourceUrls String

  submitterName  String?
  submitterEmail String?

  // pending | approved | rejected
  status       String  @default("pending")
  reviewerNote String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  // Set once approved and copied into a Project row, so we can link back.
  publishedProjectId String?
}

// One row per submission of the feedback widget (src/components/
// FeedbackWidget.tsx, shown once per browser via a localStorage flag,
// never re-prompted) — a single optional-comment-and-email screen, only
// ever written when the visitor actually enters something; closing the
// widget without typing anything writes nothing.
//
// `intent` predates this shape (this widget used to open with a "what
// brings you here" multiple-choice question first) — kept nullable rather
// than dropped so historical answers aren't destroyed, but no longer
// written by anything; always null on a new row.
model VisitorFeedback {
  id           String   @id @default(cuid())
  intent       String?
  path         String
  feedbackText String?
  contactEmail String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// One row per request to /mcp or /api/projects — added because this project
// has no analytics package and Vercel's own CLI log retention is only
// ~20 minutes with no Log Drains configured, so without a durable store
// there was no way to ever answer "has an agent used this" even a day
// later, let alone feed a daily digest email. See those routes' own
// `console.log`-replacing write for what's captured.
model ApiRequestLog {
  id         Int      @id @default(autoincrement())
  // "mcp" | "api_projects" | "api_export" | "api_snapshots"
  endpoint   String
  method     String
  userAgent  String?
  // Raw query string for api_projects/api_export/api_snapshots; null for
  // mcp (its params are in the JSON-RPC body, not the URL, and not worth
  // parsing just for a log row).
  query      String?
  // MCP only: JSON-RPC method(s), the tool called, and the client name sent
  // with `initialize`. ipHash is a salted SHA-256 prefix (never the raw IP);
  // src is an optional ?src= channel tag. All null on rows logged before
  // 2026-09-25.
  rpcMethod  String?
  toolName   String?
  clientName String?
  ipHash     String?
  src        String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([endpoint])
  @@index([toolName])
  @@index([ipHash])
}

// One row per monthly point-in-time capture of the entire dataset — the
// live DB only ever holds current truth (a project's row is updated in
// place, see upsertNormalizedProject in ingest/common.ts), so without this
// there was no way for a researcher to re-fetch exactly what the dataset
// said on a date they already cited, and no way to compute "how has the
// aggregate picture changed over time" without re-deriving it from
// ProjectChange's per-project deltas. `id` is the first-of-month UTC date
// (e.g. "2026-10-01") the snapshot cron ran for, not an opaque id, so
// listing/fetching by date needs no separate lookup. `data` is every
// project's full serialized ProjectDTO at capture time (every status
// bucket, not just "in_permitting") — deliberately NOT filtered, so a past
// snapshot can answer a question about resolved/cancelled projects too.
model DatasetSnapshot {
  id           String   @id
  createdAt    DateTime @default(now())
  projectCount Int
  data         Json

  @@index([createdAt])
}

// Durable copy of every contact-form submission (src/app/api/contact) —
// previously that route only sent an email via Resend and persisted
// nothing, so there was no queryable record for the daily digest email
// (or for anything else) once the email itself scrolled out of an inbox.
model ContactSubmission {
  id           String   @id @default(cuid())
  topic        String
  name         String
  email        String
  organization String?
  message      String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// One row per predictor in the "when will this resolve" prediction game —
// a human (identified at first by an anonymous browser-generated key, same
// zero-friction pattern as the site's other no-login features, upgradeable
// later to a verified email so their history survives a device change) or
// an agent (identified by a self-declared name via the MCP submit_prediction
// tool). Exactly one of anonymousKey/agentName is set at creation — enforced
// by a CHECK constraint in the migration, not just convention — and email
// may be added later on either kind of row. No password, ever: email
// ownership is proven once via PredictorEmailVerification's token, the same
// pattern FeedSubscription already uses for its confirm link.
model Predictor {
  id String @id @default(cuid())

  anonymousKey String? @unique
  agentName    String? @unique

  // Set once a human confirms a save-your-profile email — see
  // PredictorEmailVerification. This is what makes a predictor's leaderboard
  // history durable across devices instead of tied to one browser's
  // localStorage; null until they choose to do this, never required to
  // participate.
  email             String?   @unique
  displayName       String?
  // Set when a person with a confirmed email picks their own public name (a
  // one-time choice). Until then displayName is an auto-assigned anonymous
  // handle like "Anonymous Heron 482".
  nameChosenAt      DateTime?
  // When this person decided how to appear (posted as their anonymous handle,
  // confirmed an email, or chose a name). Until then their posts are held:
  // visible only to them. Null for AI agents, whose posts are always public.
  identityDecidedAt DateTime?
  createdAt         DateTime  @default(now())

  predictions        Prediction[]
  comments           ProjectComment[]
  emailVerifications PredictorEmailVerification[]
  signInTokens       PredictorSignInToken[]
  likes              ThreadLike[]
  advocacyContacts   AdvocacyContact[]

  @@index([email])
}

// A pending (or completed) "save your profile" email confirmation —
// opaque bearer token, same shape as FeedSubscription's confirmToken.
// Kept as its own table (not just fields on Predictor) so a predictor can
// request a new verification email without losing the record of an earlier
// attempt, and so an unconfirmed, abandoned request never blocks a retry.
// A free-form comment on a project, by the same anonymous-or-saved identity
// (Predictor) that makes predictions — see submitComment in
// src/lib/community.ts. Predictions with a `why` show alongside these
// without being copied here.
model ProjectComment {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predictorId String
  predictor   Predictor @relation(fields: [predictorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())

  // The old free-form discussion box was replaced by a structured "I
  // Advocated" log: one of "submitted_comment" | "period_closed" |
  // "attended_hearing" (see src/lib/data/advocacyPoints.ts), null on the
  // handful of legacy rows written before this existed. `body` becomes an
  // optional note in that case rather than the whole post. `hearingDate` is
  // set only for "attended_hearing", copied from one of the project's own
  // ProjectHearing rows at submit time (validated server-side to be a real,
  // recent, past hearing — not free text).
  advocacyType String?
  hearingDate  DateTime?
  // "approve" | "deny" — the position behind that advocacy, e.g. "I
  // submitted a comment supporting approval". Set alongside advocacyType;
  // null on the same legacy rows advocacyType is null on.
  stance       String?

  // A reply is a comment with a parent: either another comment (one level
  // deep, replies to replies attach to the top comment) or a prediction.
  parentId     String?
  parent       ProjectComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ProjectComment[] @relation("CommentReplies")
  predictionId String?
  prediction   Prediction?      @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  likes        ThreadLike[]

  @@index([parentId])
  @@index([predictionId])
  @@index([projectId, createdAt])
  @@index([createdAt])
  @@index([predictorId, createdAt])
  @@index([advocacyType, createdAt])
}

// A like on a comment or a prediction. Exactly one of commentId/predictionId
// is set; a person can like each thing once.
model ThreadLike {
  id           String          @id @default(cuid())
  predictorId  String
  predictor    Predictor       @relation(fields: [predictorId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      ProjectComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  predictionId String?
  prediction   Prediction?     @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())

  @@unique([predictorId, commentId])
  @@unique([predictorId, predictionId])
  @@index([commentId])
  @@index([predictionId])
}

// A contact with a state energy regulator or a member of Congress, logged
// from the Advocate > National/State tabs (src/components/advocacy/
// AdvocacyContactForm.tsx) rather than tied to one project — see
// ProjectComment.advocacyType for the project-page version of the same
// idea. Counts toward the same points and leaderboard (src/lib/leaderboard.ts).
model AdvocacyContact {
  id          String    @id @default(cuid())
  predictorId String
  predictor   Predictor @relation(fields: [predictorId], references: [id], onDelete: Cascade)

  // "state_regulator" | "house" | "senate"
  targetType String
  // USPS state code — always set: which state's regulator, or which state's
  // congressional delegation, they reached.
  state      String
  // The regulator's name, picked from STATE_REGULATORS, for state_regulator.
  // Self-reported free text (optional) for house/senate, since there's no
  // built-in directory of every member of Congress to pick from.
  targetName String?

  // Which reform issues they raised — CauseSlug values (see
  // src/lib/data/causeCategories.ts), picked from the same six shown on the
  // National Advocacy tab, plus an optional free-text note for anything else.
  issues String[]
  note   String?

  createdAt DateTime @default(now())

  @@index([predictorId, createdAt])
  @@index([createdAt])
}

// A single-use, short-lived link that restores a saved profile on a new
// browser or device: emailed to a predictor's confirmed email, exchanged for
// their anonymous key once. See /api/predictions/sign-in and /restore.
model PredictorSignInToken {
  id          String    @id @default(cuid())
  predictorId String
  predictor   Predictor @relation(fields: [predictorId], references: [id], onDelete: Cascade)
  token       String    @unique
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  @@index([predictorId, createdAt])
}

model PredictorEmailVerification {
  id          String    @id @default(cuid())
  predictorId String
  predictor   Predictor @relation(fields: [predictorId], references: [id], onDelete: Cascade)
  email       String
  token       String    @unique
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([predictorId])
}

// One row per (project, predictor) — a guess for when this project will
// reach a resolved stage (see RESOLVED_STAGES). Upserted on resubmission,
// not append-only, via the @@unique below — a predictor can revise their
// guess right up until the project actually resolves. Only ever created for
// a project whose state is in the resolutionDate-eligible list (see
// src/lib/data/predictionEligibleStates.ts) — predicting on a project this
// site can never attach a real resolution date to would have nothing to
// score against.
model Prediction {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predictorId String
  predictor   Predictor @relation(fields: [predictorId], references: [id], onDelete: Cascade)

  predictedDate DateTime
  // Optional reason (max 500 chars, enforced in the API). Shown in the
  // project's Comments and the home "people" feed when present.
  why           String?
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Filled in once, the first time this project's own Project.resolutionDate
  // populates (see the scoring job) — kept on the Prediction row itself
  // rather than recomputed from Project at read time, so a predictor's
  // historical score stays frozen even if resolutionDate is later corrected
  // by an unrelated data-quality fix.
  daysOff  Int?
  scoredAt DateTime?

  replies ProjectComment[]
  likes   ThreadLike[]

  @@unique([projectId, predictorId])
  @@index([projectId])
  @@index([predictorId])
}
